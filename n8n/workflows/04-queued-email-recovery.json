    },
    "Claim Retry Atomically": {
      "main": [
        [
          {
            "node": "Claim Granted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Granted?": {
      "main": [
        [
          {
            "node": "Retry Existing Intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry Existing Intake": {
      "main": [
        [
          {
            "node": "Complete Recovery Attempt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Complete Recovery Attempt": {
      "main": [
        [
          {
            "node": "Recovered?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recovered?": {
      "main": [
        [
          {
