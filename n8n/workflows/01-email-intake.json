      "parameters": {
        "jsCode": "const email = $('Normalize Email').first().json;\nconst result = $input.first().json;\nconst status = ['processed','needs_review','ai_failed','draft_failed'].includes(result.processing_status) ? result.processing_status : 'ai_failed';\nreturn [{ json: {\n  success: status === 'processed',\n  email,\n  external_message_id: email.external_message_id,\n  category: typeof result.category === 'string' ? result.category : null,\n  priority: typeof result.priority === 'string' ? result.priority : null,\n  summary: typeof result.summary === 'string' ? result.summary : null,\n  needs_review: status === 'processed' ? false : true,\n  assigned_team: typeof result.assigned_team === 'string' ? result.assigned_team : null,\n  suggested_reply: typeof result.suggested_reply === 'string' ? result.suggested_reply : null,\n  processing_status: status,\n  error_code: status === 'ai_failed' && !result.processing_status ? 'subworkflow_failed' : (typeof result.error_code === 'string' ? result.error_code : null)\n} }];"
      },
