# Copy to .env and replace both secrets before starting Docker Compose.
MAILPILOT_TIMEZONE=America/Chicago
MAILPILOT_SLA_HIGH_SECONDS=900
MAILPILOT_SLA_MEDIUM_SECONDS=3600
MAILPILOT_SLA_LOW_SECONDS=14400
MAILPILOT_MAX_RETRY_ATTEMPTS=3
MAILPILOT_RETRY_BASE_SECONDS=30
MAILPILOT_RETRY_LEASE_SECONDS=90
POSTGRES_PASSWORD=replace-with-a-random-secret
MAILPILOT_INTERNAL_TOKEN=replace-with-a-different-random-secret
# A separate Vercel/Next.js-to-Go secret. Required when APP_ENV=production.
MAILPILOT_FRONTEND_TOKEN=replace-with-a-third-random-secret
MAILPILOT_EMAIL_SIMULATION_RATE_LIMIT=10
