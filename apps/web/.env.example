# The Go API is bound to localhost by Docker Compose for this local demo.
GO_API_URL=http://127.0.0.1:8080
# Must match MAILPILOT_FRONTEND_TOKEN in the Go API environment. Server-only.
GO_API_SHARED_SECRET=replace-with-the-go-frontend-secret
# Auth.js settings for the protected portfolio demo. Server-only.
AUTH_SECRET=replace-with-a-long-random-secret
MAILPILOT_DEMO_EMAIL=demo@example.com
MAILPILOT_DEMO_PASSWORD=replace-with-a-strong-demo-password
